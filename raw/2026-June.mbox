>                                y <- sum(dbinom(i, n, p) <= d * relErr)
>                                pbinom(x, n, p) +
>                                    pbinom(n - y, n, p, lower.tail = FALSE)
>                            } else {
>                                i <- seq.int(from = 0, to = floor(m))
